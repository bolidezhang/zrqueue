{
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}"
    },
    "tasks": [
        {
            "_comment": "Generator name is Windows/VS-specific. On Linux use: cmake -S . -B build -DCMAKE_BUILD_TYPE=Release",
            "label": "cmake: configure (Debug)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S", ".",
                "-B", "build",
                "-G", "Visual Studio 18 2026",
                "-A", "x64",
                "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
            ],
            "problemMatcher": []
        },
        {
            "label": "cmake: configure (Release)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S", ".",
                "-B", "build",
                "-G", "Visual Studio 18 2026",
                "-A", "x64",
                "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
            ],
            "problemMatcher": []
        },
        {
            "label": "cmake: build (Debug)",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "build", "--config", "Debug", "--parallel"],
            "dependsOn": ["cmake: configure (Debug)"],
            "problemMatcher": ["$msCompile"],
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "cmake: build (Release)",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "build", "--config", "Release", "--parallel"],
            "dependsOn": ["cmake: configure (Release)"],
            "problemMatcher": ["$msCompile"],
            "group": "build"
        },
        {
            "label": "cmake: test (Debug)",
            "type": "shell",
            "command": "ctest",
            "args": ["--test-dir", "build", "-C", "Debug", "--output-on-failure"],
            "dependsOn": ["cmake: build (Debug)"],
            "problemMatcher": [],
            "group": { "kind": "test", "isDefault": true }
        },
        {
            "label": "cmake: test (Release)",
            "type": "shell",
            "command": "ctest",
            "args": ["--test-dir", "build", "-C", "Release", "--output-on-failure"],
            "dependsOn": ["cmake: build (Release)"],
            "problemMatcher": [],
            "group": "test"
        }
    ]
}
